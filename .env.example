# --- Postgres (container único, dois databases) ---
DB_USER=pulsecare
DB_PASSWORD=pulsecare
DB_PORT=5432

# Criado automaticamente via POSTGRES_DB / init-databases.sql
AGENDAMENTO_DB_NAME=agendamento_db
HISTORICO_DB_NAME=historico_db

# --- RabbitMQ ---
RABBITMQ_USER=pulsecare
RABBITMQ_PASSWORD=pulsecare
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Datasource de cada serviço (uso local, fora do Docker Compose) ---
AGENDAMENTO_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agendamento_db
HISTORICO_DATASOURCE_URL=jdbc:postgresql://localhost:5432/historico_db

# --- JWT (compartilhado entre os módulos via pulse-care-core) ---
JWT_SECRET=troque-esta-chave-por-uma-com-no-minimo-32-caracteres
JWT_EXPIRATION_MS=3600000

# --- Portas expostas dos serviços (usadas pelo docker-compose) ---
AGENDAMENTO_PORT=3710
HISTORICO_PORT=3711
NOTIFICACAO_PORT=3712
